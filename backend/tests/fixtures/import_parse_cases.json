  "text_cases": [
    {
      "name": "dedup_keeps_last_and_skips_blanks",
      "text": "\ufeffdup@outlook.com----OldPass----9e5f94bc-e8a4-4e73-b8be-63364c29d753----M.C512_BAY.0.U.-OLD_TOKEN_0123456789ABCDEFGHIJKLMNOPQRSTUV\r\n\r\n   \r\nok@outlook.com----OkPass----9e5f94bc-e8a4-4e73-b8be-63364c29d753----M.C512_BAY.0.U.-OK_TOKEN_0123456789ABCDEFGHIJKLMNOPQRSTUVW\r\nDUP@outlook.com----NewPass----9e5f94bc-e8a4-4e73-b8be-63364c29d753----M.C512_BAY.0.U.-NEW_TOKEN_0123456789ABCDEFGHIJKLMNOPQRSTUV",
      "separator": "auto",
      "max_rows": 5000,
      "expect": {
        "total_non_empty": 3,
        "over_limit": false,
        "rows_emails": ["ok@outlook.com", "dup@outlook.com"],
        "rows_lines": [4, 5],
        "invalid_lines": [],
        "duplicates_lines": [1],
        "conflict_lines": [],
        "last_row_password": "NewPass"
      }
    },
