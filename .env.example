# 复制为 .env 后填写真实值：
#   cp .env.example .env
#   然后用 openssl rand -hex 32 生成 JWT_SECRET_KEY

# 必填：JWT 密钥
JWT_SECRET_KEY=please_change_me_to_a_long_random_hex

# CORS 允许的前端来源，多个用逗号分隔
# 请改成你实际访问地址（含协议和端口；默认服务端口 11180）
ALLOWED_ORIGINS=http://localhost:11180,http://127.0.0.1:11180

TZ=Asia/Shanghai
HOST=0.0.0.0
FLASK_PORT=5000
WS_PORT=8765
FLASK_ENV=production

# Outlook token 自动续期（秒，可选）
OUTLOOK_TOKEN_REFRESH_INTERVAL=1500
OUTLOOK_TOKEN_RENEW_BEFORE=600
