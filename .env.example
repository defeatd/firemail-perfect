# 复制为 .env 后填写真实值：
#   cp .env.example .env
#   然后用 openssl rand -hex 32 生成 JWT_SECRET_KEY

# 必填：JWT 密钥
JWT_SECRET_KEY=please_change_me_to_a_long_random_hex

# 宿主机绑定地址与端口（默认仅绑定本机回环）
HOST_BIND=127.0.0.1
HOST_PORT=11180

# CORS 允许的前端来源，多个用逗号分隔
# 若通过 Cloudflare Tunnel 或反代域名访问，请追加 https://your.domain
ALLOWED_ORIGINS=http://127.0.0.1:11180,http://localhost:11180

TZ=Asia/Shanghai
HOST=0.0.0.0
FLASK_PORT=5000
WS_PORT=8765
FLASK_ENV=production

# Outlook OAuth refresh_token 主动保活配置（可选）
OUTLOOK_TOKEN_KEEPER_ENABLED=true
OUTLOOK_KEEPER_TICK_SECONDS=60
OUTLOOK_KEEPER_CONCURRENCY=4
OUTLOOK_RT_ROTATE_AFTER_DAYS=30
# 批量导入后台首验并发与限速（可选）
OUTLOOK_IMPORT_VERIFY_CONCURRENCY=4
OUTLOOK_IMPORT_VERIFY_RPS=4.0
# 租户覆盖（留空则按域名自动选择：个人域名 consumers，组织域名 common）
# OUTLOOK_OAUTH_TENANT=
# OUTLOOK_OAUTH_SCOPE=
