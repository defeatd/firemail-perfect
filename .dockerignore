# 忽略所有文件，然后再包含必要的文件
*

# 包含必要文件
!backend/
!frontend/**
!docker-entrypoint.sh
!nginx.conf
!Caddyfile

# 忽略不需要的目录和文件
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.ruff_cache/
**/.git/
**/.vscode/
**/.idea/
**/node_modules/
**/.vite/
frontend/dist/
frontend/src/tests/
frontend/.eslintrc.cjs
frontend/.eslintignore
frontend/vitest.config.js
backend/tests/
backend/requirements-dev.txt
backend/logs/
backend/FireMail.log
backend/data/*.db
backend/data/*.db-*
backend/data/*.lock
